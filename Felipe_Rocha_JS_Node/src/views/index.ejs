<!DOCTYPE html>
<html lang="en">

<%- include('./partials/head.ejs') %>

    <body>
        <!-- To use JS in an EJS file, we need to use <% %> 
    <% const message='Hello World!' %>
        <h1>
            <%=message %>
        </h1>
    -->
        <%- include('./partials/navbar.ejs') %>
            <div class="content">
                <% if (users.length> 0) { %> <% users.forEach(user=> { %>
                        <h3 class="title">
                            <%= user.firstName %>
                                <%= user.lastName %>
                        </h3>
                        <p>
                            <%= user.email %>
                        </p>
                        <% }) %>
                            <% } else { %>
                                <p>There are no users to display...</p>
                                <% } %>
            </div>
    </body>

</html>